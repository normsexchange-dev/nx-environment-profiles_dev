{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-environment-profiles_dev/environment-profiles-v1.1.0/schemas/repository-functions-v1.1.schema.json",
  "title": "NX repository functions 1.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "functions", "compatibility"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/normsexchange-dev/nx-environment-profiles_dev/environment-profiles-v1.1.0/schemas/repository-functions-v1.1.schema.json"},
    "schema_version": {"const": "1.1.0"},
    "functions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["function_id", "default_name", "lifecycle", "recommended_visibility", "writer", "data_classes"],
        "properties": {
          "function_id": {"enum": ["nx-agent-control", "nx-agent-ops", "nx-communications", "nx-to-recipient", "nx-message-store"]},
          "default_name": {"type": "string", "minLength": 1},
          "lifecycle": {"enum": ["released-v1.0", "candidate-v1.1"]},
          "recommended_visibility": {"enum": ["public", "private", "owner-selected"]},
          "writer": {"type": "string", "minLength": 1},
          "data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairwise_v1_function", "group_store_v1_1_function", "migration"],
      "properties": {
        "pairwise_v1_function": {"const": "nx-to-recipient"},
        "group_store_v1_1_function": {"const": "nx-message-store"},
        "migration": {"const": "parallel-additive-no-rename"}
      }
    }
  }
}
