{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-environment-profiles_dev/environment-profiles-v1.0.0/schemas/agent-registry.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "environment_id", "agents"],
  "properties": {"schema_version": {"const": "1.0.0"}, "environment_id": {"type": "string", "minLength": 1}, "agents": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["agent_id", "runtime_adapter", "status", "enrollments", "created_at"], "properties": {"agent_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}, "runtime_adapter": {"type": "string", "minLength": 1}, "status": {"enum": ["proposed", "active", "suspended", "retired"]}, "enrollments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "created_at": {"type": "string", "minLength": 1}}}}}
}
