{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-environment-profiles_dev/environment-profiles-v1.0.0/schemas/health.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "subject", "dimensions", "checked_at"],
  "properties": {"schema_version": {"const": "1.0.0"}, "subject": {"type": "string", "minLength": 1}, "dimensions": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["state", "evidence"], "properties": {"state": {"enum": ["GO", "DEGRADED", "NO-GO", "UNKNOWN", "CONDITIONAL"]}, "evidence": {"type": "string", "minLength": 1}}}}, "checked_at": {"type": "string", "minLength": 1}}
}
