{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-environment-profiles_dev/environment-profiles-v1.0.0/schemas/usage-summary.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "record_id", "agent_id", "goal_id", "started_at", "ended_at", "metrics", "source", "immutable"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_id": {"type": "string", "minLength": 12}, "agent_id": {"type": "string", "minLength": 1}, "goal_id": {"type": ["string", "null"]}, "started_at": {"type": "string", "minLength": 1}, "ended_at": {"type": ["string", "null"]}, "metrics": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "null"]}}, "source": {"type": "string", "minLength": 1}, "immutable": {"const": true}}
}
