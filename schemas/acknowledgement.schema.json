{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-environment-profiles_dev/environment-profiles-v1.0.0/schemas/acknowledgement.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "ack_id", "message_id", "from_agent", "state", "created_at", "immutable"],
  "properties": {"schema_version": {"const": "1.0.0"}, "ack_id": {"type": "string", "minLength": 12}, "message_id": {"type": "string", "minLength": 12}, "from_agent": {"type": "string", "minLength": 1}, "state": {"enum": ["received", "accepted", "rejected", "completed"]}, "created_at": {"type": "string", "minLength": 1}, "immutable": {"const": true}}
}
